# ==============================================================================
# Annam Pagirvom (அன்னம் பகிர்வோம்) — Environment Configuration Template
# Event: GENCRAFT’26 Hack4Goals • PS14 Food Waste Reduction
# District Focus: Karur District, Tamil Nadu
# ==============================================================================

# Core Application Security
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=False
PORT=5000

# Database Configuration (Defaults to persistent local SQLite)
DATABASE_URL=sqlite:///instance/foodbridge.db

# Optional External Cloud Database & Storage (e.g. Supabase / PostgreSQL)
# If connecting to an external Supabase instance for central cross-device data:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-keep-private
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Geolocation Defaults (Karur District Central Coordinates)
DEFAULT_DISTRICT=Karur
DEFAULT_LATITUDE=10.9601
DEFAULT_LONGITUDE=78.0766

# Emergency Helplines (Karur District Official Contacts)
EMERGENCY_HELPLINE_PRIMARY=04324-222333
EMERGENCY_HELPLINE_TOLLFREE=1800-425-1333
